+// Marauder Console patch: drive the CYD's RGB LED with analogWrite (8-bit PWM) so it can mix colours such
+// as purple. The LED is common-anode (active-low), so 255 is full brightness and 0 is off. Every write goes
+// through here, because on core 2.x a pin attached to PWM ignores digitalWrite.
+static void marauderSetRGB(uint8_t r, uint8_t g, uint8_t b) {
+  analogWrite(R_PIN, 255 - r);
+  analogWrite(G_PIN, 255 - g);
+  analogWrite(B_PIN, 255 - b);
+}
+
 void flipperLED::RunSetup() {
   pinMode(B_PIN, OUTPUT);
   pinMode(G_PIN, OUTPUT);
   pinMode(R_PIN, OUTPUT);
 
   if (!settings_obj.loadSetting<bool>("EnableLED")) {
-    digitalWrite(B_PIN, HIGH);
-    digitalWrite(G_PIN, HIGH);
-    digitalWrite(R_PIN, HIGH);
+    marauderSetRGB(0, 0, 0);
     return;
   }
     
   delay(50);
 
-  digitalWrite(B_PIN, LOW);
+  marauderSetRGB(0, 0, 255);
   delay(500);
-  digitalWrite(B_PIN, HIGH);
-  digitalWrite(G_PIN, LOW);
+  marauderSetRGB(0, 255, 0);
   delay(500);
-  digitalWrite(G_PIN, HIGH);
-  digitalWrite(R_PIN, LOW);
+  marauderSetRGB(255, 0, 0);
   delay(500);
-  digitalWrite(R_PIN, HIGH);
+  marauderSetRGB(0, 0, 0);
 }
 
