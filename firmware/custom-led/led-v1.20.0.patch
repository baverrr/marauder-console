+// Marauder Console patch: hold the LED solid green, or (LED_ALTERNATE) alternate it between purple and
+// green. Re-written once per LED_ALTERNATE_MS tick rather than every loop, so the stock scan colours
+// (red/blue) show only until the next tick. Respects the EnableLED setting, checked once per tick, so
+// turning it off in Settings takes effect within a second.
 void flipperLED::main() {
-  // do nothing
+  // Purple needs a working red channel; on a board whose red is dead it just shows blue, so this
+  // defaults to solid green. Set true for purple/green.
+  static const bool LED_ALTERNATE = false;
+  static const uint32_t LED_ALTERNATE_MS = 1000;
+  // The blue die on the CYD's LED is much brighter than the red, so purple needs full red and dimmed
+  // blue; with blue at full it just reads as blue. Raise PURPLE_B for a bluer purple, lower it for pinker.
+  static const uint8_t PURPLE_R = 255;
+  static const uint8_t PURPLE_B = 64;
+  static uint32_t shown_tick = UINT32_MAX;
+
+  uint32_t tick = millis() / LED_ALTERNATE_MS;
+  if (tick == shown_tick)
+    return;
+  shown_tick = tick;
+  if (!settings_obj.loadSetting<bool>("EnableLED"))
+    marauderSetRGB(0, 0, 0);
+  else if (LED_ALTERNATE && (tick % 2 == 0))
+    marauderSetRGB(PURPLE_R, 0, PURPLE_B);  // purple
+  else
+    marauderSetRGB(0, 255, 0);              // green
 }
 
