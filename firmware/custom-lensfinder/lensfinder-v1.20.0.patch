diff --git a/esp32_marauder/LensFinder.cpp b/esp32_marauder/LensFinder.cpp
new file mode 100644
index 0000000..6c72506
--- /dev/null
+++ b/esp32_marauder/LensFinder.cpp
@@ -0,0 +1,143 @@
+#include "LensFinder.h"
+
+#ifdef HAS_SCREEN
+  #include "Display.h"
+  #include "MenuFunctions.h"
+  extern Display display_obj;
+  extern MenuFunctions menu_function_obj;
+  extern void backlightOn();
+  extern void backlightOff();
+#endif
+
+// Keep the instructions up this long, then turn the backlight off so the screen doesn't wash out the
+// operator's dark-adapted eye (and the glints they're looking for).
+static const uint32_t LENS_FINDER_SCREEN_MS = 5000;
+
+bool LensFinder::start(uint8_t hz, bool white) {
+  #ifdef HAS_FLIPPER_LED
+    if (hz > MAX_HZ) hz = MAX_HZ;
+    #ifdef HAS_SCREEN
+      if (this->running && this->screen_dark) backlightOn();  // restarted with new settings
+    #endif
+    this->hz = hz;
+    this->white = white;
+    this->running = true;
+    this->screen_dark = false;
+    this->touch_armed = false;
+    this->stop_pending = false;
+    this->started_ms = millis();
+    this->last_toggle_ms = this->started_ms;
+    this->needs_draw = true;
+    this->setLight(true);
+    return true;
+  #else
+    (void)hz;
+    (void)white;
+    return false;
+  #endif
+}
+
+void LensFinder::setLight(bool on) {
+  #ifdef HAS_FLIPPER_LED
+    // The CYD's RGB LED is active-low. Driven directly (not through flipperLED) so it works even with
+    // the EnableLED setting off — the operator asked for the light explicitly.
+    digitalWrite(R_PIN, on ? LOW : HIGH);
+    digitalWrite(G_PIN, (on && this->white) ? LOW : HIGH);
+    digitalWrite(B_PIN, (on && this->white) ? LOW : HIGH);
+    this->lit = on;
+  #else
+    (void)on;
+  #endif
+}
+
+void LensFinder::drawInstructions() {
+  #ifdef HAS_SCREEN
+    TFT_eSPI& tft = display_obj.tft;
+    tft.fillScreen(TFT_BLACK);
+    tft.setTextWrap(true);
+    tft.setTextSize(2);
+    tft.setTextColor(TFT_RED, TFT_BLACK);
+    tft.setCursor(0, 8);
+    tft.println("LENS FINDER");
+    tft.setTextSize(1);
+    tft.println();
+    tft.println("Turn the room lights off.");
+    tft.println("Hold the board screen-up, the LED");
+    tft.println("on the back facing the room, just");
+    tft.println("below your eye. Look over the top");
+    tft.println("edge and sweep slowly.");
+    tft.println();
+    tft.println("A camera lens shows as a tiny,");
+    tft.println("sharp glint that blinks with the");
+    tft.println("LED and stays put as you move.");
+    tft.println();
+    tft.print(this->white ? "White" : "Red");
+    if (this->hz == 0) tft.println(", steady.");
+    else {
+      tft.print(", strobing at ");
+      tft.print(this->hz);
+      tft.println(" Hz.");
+    }
+    tft.println();
+    tft.println("Screen goes dark in 5 s.");
+    tft.println("Tap anywhere to stop.");
+  #endif
+}
+
+bool LensFinder::main(uint32_t now) {
+  if (!this->running) return false;
+
+  if (this->hz > 0) {
+    const uint32_t half_period = 500 / this->hz;
+    if (now - this->last_toggle_ms >= half_period) {
+      this->last_toggle_ms = now;
+      this->setLight(!this->lit);
+    }
+  }
+
+  #ifdef HAS_SCREEN
+    if (this->needs_draw) {
+      this->needs_draw = false;
+      this->drawInstructions();
+    }
+    if (!this->screen_dark && now - this->started_ms >= LENS_FINDER_SCREEN_MS) {
+      backlightOff();
+      this->screen_dark = true;
+    }
+
+    #ifdef HAS_TOUCH
+      uint16_t tx = 0, ty = 0;
+      const bool touched = display_obj.updateTouch(&tx, &ty);
+      if (!touched) {
+        if (this->stop_pending) {
+          this->finish();
+          return false;
+        }
+        this->touch_armed = true;
+      }
+      else if (this->touch_armed) {
+        this->stop_pending = true;
+      }
+    #endif
+  #endif
+
+  return true;
+}
+
+void LensFinder::stop() {
+  if (!this->running) return;
+  this->finish();
+}
+
+void LensFinder::finish() {
+  this->setLight(false);
+  this->running = false;
+  this->stop_pending = false;
+  Serial.println(F("Lens finder stopped"));
+  #ifdef HAS_SCREEN
+    backlightOn();
+    // Count the stop as activity so an idle screensaver doesn't kick in straight away.
+    display_obj.last_touch_ms = millis();
+    menu_function_obj.changeMenu(menu_function_obj.current_menu);
+  #endif
+}
diff --git a/esp32_marauder/LensFinder.h b/esp32_marauder/LensFinder.h
new file mode 100644
index 0000000..6214b37
--- /dev/null
+++ b/esp32_marauder/LensFinder.h
@@ -0,0 +1,46 @@
+#pragma once
+
+#ifndef LensFinder_h
+#define LensFinder_h
+
+// Marauder Console patch: optical lens finder. Strobes the board's RGB status LED so the operator can
+// sweep a room looking for the bright retro-reflection ("cat's-eye" glint) that a camera lens throws
+// straight back at a light source near the viewer's eye. The ESP32 drives the light; the operator's eye
+// is the detector — the CYD has no rear-facing light sensor to do it automatically.
+
+#include "configs.h"
+
+#include <Arduino.h>
+
+class LensFinder {
+  public:
+    static const uint8_t MIN_HZ = 1;
+    static const uint8_t MAX_HZ = 20;
+    static const uint8_t DEFAULT_HZ = 4;
+
+    // hz == 0 means a steady light; white lights all three channels instead of just red.
+    bool start(uint8_t hz, bool white);
+    void stop();
+    bool active() const { return this->running; }
+    // Call every loop(). Returns true while the lens finder owns the screen and touch, so the caller
+    // skips normal menu drawing/input.
+    bool main(uint32_t now);
+
+  private:
+    void setLight(bool on);
+    void drawInstructions();
+    void finish();
+
+    bool running = false;
+    bool white = false;
+    bool lit = false;
+    bool needs_draw = false;     // draw on the first main() pass, after any menu redraw has finished
+    bool screen_dark = false;
+    bool touch_armed = false;    // a tap only counts once the finger that started us has lifted
+    bool stop_pending = false;   // tapped: wait for release so the tap doesn't hit a menu button
+    uint8_t hz = DEFAULT_HZ;
+    uint32_t started_ms = 0;
+    uint32_t last_toggle_ms = 0;
+};
+
+#endif
