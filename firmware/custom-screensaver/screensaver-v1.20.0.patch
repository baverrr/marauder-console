+// Marauder Console patch: idle logo screensaver for the CYD. After 30s with no touch (and only when not
+// scanning), it shows the Marauder logo centred on black; the next tap wakes and restores the current
+// screen (and is consumed, so it doesn't also trigger a menu button). Returns true while the saver is up
+// so the loop skips normal menu drawing/input. No-op on boards without CYD touch tracking.
+static bool marauderScreensaverStep(uint32_t now) {
+  #if defined(HAS_SCREEN) && defined(HAS_CYD_TOUCH)
+    static const uint32_t SCREENSAVER_TIMEOUT_MS = 30000;
+    static bool active = false;
+    if (active) {
+      uint16_t tx = 0, ty = 0;
+      if (display_obj.updateTouch(&tx, &ty)) {
+        active = false;
+        menu_function_obj.changeMenu(menu_function_obj.current_menu);  // restore the screen
+      }
+      return active;
+    }
+    if (!wifi_scan_obj.scanning() &&
+        (now - display_obj.last_touch_ms >= SCREENSAVER_TIMEOUT_MS)) {
+      display_obj.drawScreensaver();
+      active = true;
+    }
+    return active;
+  #else
+    (void)now;
+    return false;
+  #endif
+}
