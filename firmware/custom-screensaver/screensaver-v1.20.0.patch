+// Marauder Console patch: idle screensaver — just the Marauder logo, centred on a black screen. Reuses
+// the boot-splash logo sampler (cleanLogoPixel) so no new image asset is needed.
+void Display::drawScreensaver() {
+  const int16_t width = tft.width();
+  const int16_t height = tft.height();
+  #if defined(MARAUDER_CYD_3_5_INCH) || defined(MARAUDER_PANCAKE)
+    constexpr bool half_scale_logo = true;
+  #else
+    constexpr bool half_scale_logo = false;
+  #endif
+  const marauder::BootSplashLayout layout =
+      marauder::bootSplashLayout(width, height, half_scale_logo);
+  const int16_t logo_w = layout.logo_width;
+  const int16_t logo_h = layout.logo_height;
+  const int16_t logo_x = (width - logo_w) / 2;
+  const int16_t logo_y = (height - logo_h) / 2;  // centred on the full screen, no title/version
+
+  tft.fillScreen(TFT_BLACK);
+  const uint32_t source_x_step = logo_w > 1
+      ? (static_cast<uint32_t>(JCMK_LOGO_WIDTH - 1) << 8) / (logo_w - 1) : 0;
+  const uint32_t source_y_step = logo_h > 1
+      ? (static_cast<uint32_t>(JCMK_LOGO_HEIGHT - 1) << 8) / (logo_h - 1) : 0;
+  for (int16_t y = 0; y < logo_h; ++y) {
+    int16_t run_start = -1;
+    for (int16_t x = 0; x <= logo_w; ++x) {
+      const bool white = x < logo_w &&
+          cleanLogoPixel(x, y, logo_w, logo_h, source_x_step, source_y_step);
+      if (white && run_start < 0) run_start = x;
+      if (!white && run_start >= 0) {
+        tft.drawFastHLine(logo_x + run_start, logo_y + y, x - run_start, TFT_WHITE);
+        run_start = -1;
+      }
+    }
+  }
+}
