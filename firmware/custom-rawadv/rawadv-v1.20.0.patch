diff --git a/esp32_marauder/WiFiScan.cpp b/esp32_marauder/WiFiScan.cpp
index 198530d..4fa6af9 100644
--- a/esp32_marauder/WiFiScan.cpp
+++ b/esp32_marauder/WiFiScan.cpp
@@ -542,6 +542,22 @@ extern "C" {
               //Serial.flush();
               Serial.print(rssi);
               Serial.println(" " + mac);
+              // Marauder Console patch: opt-in raw advertisement dump. `payLoad`/`len` above are the full
+              // advertising data; print them as hex on a distinct "RAWADV " line so the console can decode
+              // the AD structures. payLoad indexes the same for the NimBLE-1 (uint8_t*) and NimBLE-2
+              // (std::vector) forms resolved earlier in this branch.
+              if (wifi_scan_obj.bt_raw_dump) {
+                Serial.print(F("RAWADV "));
+                Serial.print(mac);
+                Serial.print(' ');
+                Serial.print(rssi);
+                Serial.print(' ');
+                for (size_t i = 0; i < len; i++) {
+                  if (payLoad[i] < 0x10) Serial.print('0');
+                  Serial.print(payLoad[i], HEX);
+                }
+                Serial.println();
+              }
               //Serial.print(F("Payload Len: "));
               //Serial.print(len);
               //Serial.println("\n");
