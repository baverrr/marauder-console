{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Marauder Console",
  "version": "0.1.0",
  "identifier": "com.baverrr.marauder-console",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Control panel for an ESP32 Marauder board.",
    "longDescription": "Desktop shell around the Marauder Console UI, with the Python serial bridge bundled as a sidecar. The window is created only after the bridge is reachable; the bridge URL is injected into the web UI at load time.",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
