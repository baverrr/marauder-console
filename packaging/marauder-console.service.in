[Unit]
Description=Marauder Console bridge (serves the web UI and owns the ESP32 serial port on demand)
Documentation=https://github.com/baverrr/marauder-console

[Service]
# The bridge opens the serial port only while the UI is "connected", so running it as a service does not
# hold /dev/ttyUSB0 the rest of the time. -I isolates the interpreter from the invoking environment.
ExecStart="@APP_DIR@/venv/bin/python" -I "@APP_DIR@/bridge.py" serve --host 127.0.0.1 --port 8200
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
